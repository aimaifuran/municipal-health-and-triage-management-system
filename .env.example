SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Set to 1 for local dev without PostgreSQL (uses db.sqlite3; see config/settings/development.py)
USE_SQLITE_DEV=0
# Render: use your-service.onrender.com,.onrender.com (see docs/DEPLOY_RENDER.md)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
DATABASE_URL=postgres://user:password@localhost:5432/mhtms
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Render: https://your-service.onrender.com (must match CSRF_TRUSTED_ORIGINS host)
CSRF_TRUSTED_ORIGINS=https://mhtms.onrender.com
CORS_ALLOWED_ORIGINS=https://mhtms.onrender.com
SECURE_SSL_REDIRECT=True
DJANGO_SETTINGS_MODULE=config.settings.production

AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1

RATE_LIMIT_PUBLIC=100/h
RATE_LIMIT_AUTHENTICATED=1000/h

# Consult AI (Doctor queue → Consult → Consult AI). See docs/CONSULT_AI_SETUP.md
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
